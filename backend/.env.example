# Copy this file to .env and fill in your own values
NODE_ENV=development
PORT=5000

# Local MongoDB: mongodb://127.0.0.1:27017/modi-handloom
# Or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/modi-handloom

# Any long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# Frontend origin allowed to call this API
CLIENT_URL=http://localhost:5173

# Base URL this API is served from — used to build full image URLs for
# anything placed in backend/public/uploads
SERVER_URL=http://localhost:5000
